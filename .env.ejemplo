# Copia este archivo como .env y completa tus valores. El .env NUNCA se sube a Git.

# 1 = respuestas de ejemplo (sin internet, sin costo). 0 = usa el proveedor real de abajo.
MOCK_MODE=1

# ---------------------------------------------------------------------------
# PROVEEDOR: cualquiera compatible con la API de OpenAI. Descomenta UNA opción.
# Los nombres de modelo y si son gratuitos CAMBIAN seguido: revisar la página
# de modelos del proveedor antes de elegir.
# ---------------------------------------------------------------------------

# OpenRouter (tiene modelos gratuitos, terminan en ":free")  -> https://openrouter.ai/models
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...

# Groq (capa gratuita con límite de uso)  -> https://console.groq.com/docs/models
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# Google Gemini (capa gratuita con límite de uso)  -> https://ai.google.dev/gemini-api/docs/openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...

# Ollama en tu PC (gratis, sin internet, necesita buena RAM)  -> https://ollama.com/search
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# OpenAI (de pago): deja LLM_BASE_URL vacío
# LLM_API_KEY=sk-proj-...

# ---------------------------------------------------------------------------
# MODELOS (nombre exacto como lo muestra el proveedor)
# ---------------------------------------------------------------------------
AGENT_MODEL=
CHIEF_MODEL=
# Opcional: un modelo distinto por agente (si se dejan vacíos, usan AGENT_MODEL)
# CLINICAL_MODEL=
# PHARMACOLOGICAL_MODEL=
# PROTOCOL_MODEL=

# ---------------------------------------------------------------------------
# COMPATIBILIDAD: cambiar solo si el proveedor da error
# ---------------------------------------------------------------------------
# 0 si el error menciona "response_format" o "json_object"
LLM_JSON_MODE=1
# 1 si el error dice que el modelo no acepta instrucciones de sistema ("system"/"developer")
LLM_MERGE_SYSTEM_PROMPT=0
